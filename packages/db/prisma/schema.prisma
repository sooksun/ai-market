// AI Market — Prisma schema
// Phase 0 (Foundation) only. Next phases will be added per migration step.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  REQUESTER
  PROJECT_OWNER
  PROCUREMENT
  FINANCE
  INSPECTOR
  DIRECTOR
  AUDITOR
  ADMIN
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  RETURNED
  APPROVED_FOR_COMPARISON
  IN_COMPARISON
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_RECEIVING
  RECEIVED
  CLOSED
  CANCELLED
}

enum ItemClass {
  MATERIAL
  ASSET
  SERVICE
  UNCLASSIFIED
}

enum SpecLevel {
  MUST_HAVE
  NICE_TO_HAVE
  INFO
}

enum SpecSource {
  HUMAN
  AI
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
}

enum RiskType {
  AMBIGUOUS_SPEC
  BRAND_LOCK
  PRICE_OUTLIER
  INSUFFICIENT_QUOTES
  MISSING_DOC
  BUDGET_OVERRUN
  REASON_MISSING
  CLASSIFICATION_UNCERTAIN
  OTHER
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model School {
  id        String    @id @default(cuid())
  name      String
  shortName String?   @map("short_name")
  taxId     String?   @map("tax_id")
  address   String?   @db.Text
  phone     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users            User[]
  rules            RuleConfig[]
  auditLogs        AuditLog[]
  purchaseRequests PurchaseRequest[]
  attachments      Attachment[]
  projects         Project[]
  budgetSources    BudgetSource[]
  vendors          Vendor[]

  @@map("schools")
}

// Phase 1.8 placeholder — Phase 2 จะมี budgets/budget_movements เต็มรูป
model Project {
  id         String    @id @default(cuid())
  schoolId   String    @map("school_id")
  code       String?
  name       String
  fiscalYear Int       @map("fiscal_year")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  school           School            @relation(fields: [schoolId], references: [id])
  purchaseRequests PurchaseRequest[]
  budgets          Budget[]

  @@unique([schoolId, fiscalYear, code])
  @@index([schoolId, active])
  @@map("projects")
}

model BudgetSource {
  id          String    @id @default(cuid())
  schoolId    String    @map("school_id")
  code        String?
  name        String
  type        String
  fiscalYear  Int       @map("fiscal_year")
  totalAmount Decimal   @map("total_amount") @db.Decimal(15, 2)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  school           School            @relation(fields: [schoolId], references: [id])
  purchaseRequests PurchaseRequest[]
  budgets          Budget[]

  @@unique([schoolId, fiscalYear, code])
  @@index([schoolId, active])
  @@map("budget_sources")
}

// ─────────────────────────────────────────────
// Phase 2 — Budget allocation + movements
// ─────────────────────────────────────────────

enum BudgetMovementType {
  ALLOCATE
  HOLD
  RELEASE
  COMMIT
  SPEND
  ADJUST
}

model Budget {
  id             String   @id @default(cuid())
  schoolId       String   @map("school_id")
  projectId      String   @map("project_id")
  budgetSourceId String   @map("budget_source_id")
  fiscalYear     Int      @map("fiscal_year")
  allocated      Decimal  @db.Decimal(15, 2)
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project      Project          @relation(fields: [projectId], references: [id])
  budgetSource BudgetSource     @relation(fields: [budgetSourceId], references: [id])
  movements    BudgetMovement[]

  @@unique([schoolId, fiscalYear, projectId, budgetSourceId])
  @@index([schoolId, fiscalYear])
  @@index([projectId])
  @@map("budgets")
}

model BudgetMovement {
  id          String             @id @default(cuid())
  budgetId    String             @map("budget_id")
  type        BudgetMovementType
  amount      Decimal            @db.Decimal(15, 2)
  refType     String?            @map("ref_type")
  refId       String?            @map("ref_id")
  note        String?            @db.Text
  createdById String?            @map("created_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, createdAt])
  @@index([refType, refId])
  @@map("budget_movements")
}

model User {
  id           String    @id @default(cuid())
  schoolId     String    @map("school_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  school           School            @relation(fields: [schoolId], references: [id])
  roles            UserRole[]
  auditLogs        AuditLog[]
  ruleUpdates      RuleConfig[]      @relation("RuleUpdater")
  purchaseRequests PurchaseRequest[] @relation("RequesterRequests")

  @@index([schoolId])
  @@map("users")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String?  @map("school_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  school School? @relation(fields: [schoolId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([schoolId, entityType, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model RuleConfig {
  id          String   @id @default(cuid())
  schoolId    String?  @map("school_id")
  key         String
  value       Json
  type        String
  description String?  @db.Text
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school    School? @relation(fields: [schoolId], references: [id])
  updatedBy User?   @relation("RuleUpdater", fields: [updatedById], references: [id])

  @@unique([schoolId, key])
  @@map("rule_configs")
}

model AiInvocation {
  id            String   @id @default(cuid())
  schoolId      String?  @map("school_id")
  userId        String?  @map("user_id")
  endpoint      String
  model         String
  promptVersion String   @map("prompt_version")
  input         Json
  output        Json?
  tokenInput    Int?     @map("token_input")
  tokenOutput   Int?     @map("token_output")
  latencyMs     Int?     @map("latency_ms")
  status        String
  errorMessage  String?  @map("error_message") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([endpoint, createdAt])
  @@index([userId, createdAt])
  @@map("ai_invocations")
}

// ─────────────────────────────────────────────
// Phase 1 — Purchase Request
// ─────────────────────────────────────────────

model PurchaseRequest {
  id          String                @id @default(cuid())
  schoolId    String                @map("school_id")
  docNo       String?               @map("doc_no")
  title       String
  reason      String                @db.Text
  status      PurchaseRequestStatus @default(DRAFT)
  requesterId String                @map("requester_id")
  totalAmount Decimal?              @map("total_amount") @db.Decimal(15, 2)

  projectId      String? @map("project_id")
  budgetSourceId String? @map("budget_source_id")

  submittedAt DateTime? @map("submitted_at")
  approvedAt  DateTime? @map("approved_at")
  closedAt    DateTime? @map("closed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school       School                @relation(fields: [schoolId], references: [id])
  requester    User                  @relation("RequesterRequests", fields: [requesterId], references: [id])
  project      Project?              @relation(fields: [projectId], references: [id])
  budgetSource BudgetSource?         @relation(fields: [budgetSourceId], references: [id])
  items        PurchaseRequestItem[]
  riskFlags    AiRiskFlag[]
  quotations   VendorQuotation[]
  approval     ApprovalWorkflow?
  receiving    ReceivingRecord?

  @@unique([schoolId, docNo])
  @@index([schoolId, status, createdAt])
  @@index([requesterId, createdAt])
  @@index([projectId])
  @@index([budgetSourceId])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String    @id @default(cuid())
  purchaseRequestId String    @map("purchase_request_id")
  ordinal           Int
  name              String
  quantity          Decimal   @db.Decimal(12, 2)
  unit              String
  unitPriceEst      Decimal?  @map("unit_price_est") @db.Decimal(15, 2)
  rawText           String?   @map("raw_text") @db.Text
  parsedByAi        Boolean   @default(false) @map("parsed_by_ai")
  classifiedType    ItemClass @default(UNCLASSIFIED) @map("classified_type")
  classifiedByAi    Boolean   @default(false) @map("classified_by_ai")
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  purchaseRequest PurchaseRequest     @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  specifications  ItemSpecification[]
  riskFlags       AiRiskFlag[]
  quotationItems  QuotationItem[]
  receivingItems  ReceivingItem[]

  @@unique([purchaseRequestId, ordinal])
  @@index([purchaseRequestId])
  @@map("purchase_request_items")
}

model ItemSpecification {
  id        String     @id @default(cuid())
  itemId    String     @map("item_id")
  key       String
  value     String     @db.Text
  level     SpecLevel  @default(MUST_HAVE)
  source    SpecSource @default(HUMAN)
  ordinal   Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  item PurchaseRequestItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_specifications")
}

model AiRiskFlag {
  id                String    @id @default(cuid())
  purchaseRequestId String?   @map("purchase_request_id")
  itemId            String?   @map("item_id")
  type              RiskType
  severity          RiskSeverity @default(MEDIUM)
  message           String    @db.Text
  detail            Json?
  modelVersion      String?   @map("model_version")
  invocationId      String?   @map("invocation_id")
  dismissedById     String?   @map("dismissed_by_id")
  dismissedAt       DateTime? @map("dismissed_at")
  dismissedReason   String?   @map("dismissed_reason") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")

  purchaseRequest PurchaseRequest?     @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  item            PurchaseRequestItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([purchaseRequestId])
  @@index([itemId])
  @@index([type, severity])
  @@map("ai_risk_flags")
}

// ─────────────────────────────────────────────
// Phase 3.3 — Approval workflow
// ─────────────────────────────────────────────

enum ApprovalWorkflowStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  SKIPPED
}

model ApprovalWorkflow {
  id                String                 @id @default(cuid())
  schoolId          String                 @map("school_id")
  purchaseRequestId String                 @unique @map("purchase_request_id")
  template          String?
  currentStep       Int                    @default(1) @map("current_step")
  status            ApprovalWorkflowStatus @default(IN_PROGRESS)
  startedAt         DateTime               @default(now()) @map("started_at")
  completedAt       DateTime?              @map("completed_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  steps           ApprovalStep[]

  @@index([schoolId, status])
  @@map("approval_workflows")
}

model ApprovalStep {
  id           String             @id @default(cuid())
  workflowId   String             @map("workflow_id")
  ordinal      Int
  title        String
  approverRole Role?              @map("approver_role")
  approverId   String?            @map("approver_id")
  status       ApprovalStepStatus @default(PENDING)
  comment      String?            @db.Text
  decidedById  String?            @map("decided_by_id")
  decidedAt    DateTime?          @map("decided_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, ordinal])
  @@index([workflowId])
  @@index([approverRole, status])
  @@map("approval_steps")
}

// ─────────────────────────────────────────────
// Phase 3 — Vendor / Quotation / Price Comparison
// ─────────────────────────────────────────────

enum QuotationStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  SELECTED
  REJECTED
  WITHDRAWN
}

enum QuotationSpecMatch {
  FULL
  PARTIAL
  MISMATCH
  UNKNOWN
}

model Vendor {
  id        String    @id @default(cuid())
  schoolId  String    @map("school_id")
  name      String
  taxId     String?   @map("tax_id")
  phone     String?
  email     String?
  address   String?   @db.Text
  rating    Decimal?  @db.Decimal(3, 2) // 0–5 internal rating
  notes     String?   @db.Text
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school     School            @relation(fields: [schoolId], references: [id])
  quotations VendorQuotation[]
  snapshots  PriceSnapshot[]

  @@index([schoolId, active])
  @@map("vendors")
}

model VendorQuotation {
  id                String          @id @default(cuid())
  schoolId          String          @map("school_id")
  purchaseRequestId String          @map("purchase_request_id")
  vendorId          String          @map("vendor_id")
  source            String // marketplace name หรือ "ใบเสนอราคา (กระดาษ)"
  status            QuotationStatus @default(DRAFT)
  shippingFee       Decimal         @default(0) @map("shipping_fee") @db.Decimal(15, 2)
  notes             String?         @db.Text
  submittedAt       DateTime?       @map("submitted_at")
  validUntil        DateTime?       @map("valid_until")
  selectedAt        DateTime?       @map("selected_at")
  selectedById      String?         @map("selected_by_id")
  selectionReason   String?         @map("selection_reason") @db.Text
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  vendor          Vendor          @relation(fields: [vendorId], references: [id])
  items           QuotationItem[]

  @@index([schoolId, purchaseRequestId])
  @@index([vendorId])
  @@index([status])
  @@map("vendor_quotations")
}

model QuotationItem {
  id                    String              @id @default(cuid())
  quotationId           String              @map("quotation_id")
  purchaseRequestItemId String              @map("purchase_request_item_id")
  unitPrice             Decimal             @map("unit_price") @db.Decimal(15, 2)
  quantity              Decimal?            @db.Decimal(12, 2) // override if vendor offers different qty
  specMatch             QuotationSpecMatch  @default(UNKNOWN) @map("spec_match")
  specMatchDetail       String?             @map("spec_match_detail") @db.Text
  notes                 String?             @db.Text

  quotation           VendorQuotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  purchaseRequestItem PurchaseRequestItem @relation(fields: [purchaseRequestItemId], references: [id], onDelete: Cascade)

  @@unique([quotationId, purchaseRequestItemId])
  @@index([purchaseRequestItemId])
  @@map("quotation_items")
}

model PriceSnapshot {
  id         String   @id @default(cuid())
  schoolId   String   @map("school_id")
  vendorId   String?  @map("vendor_id")
  itemName   String   @map("item_name")
  unitPrice  Decimal  @map("unit_price") @db.Decimal(15, 2)
  unit       String
  source     String // URL, marketplace name, or "manual:..."
  observedAt DateTime @default(now()) @map("observed_at")
  rawData    Json?    @map("raw_data")

  vendor Vendor? @relation(fields: [vendorId], references: [id])

  @@index([schoolId, itemName])
  @@index([vendorId, observedAt])
  @@map("price_snapshots")
}

// ─────────────────────────────────────────────
// Phase 3.4 — Document templates
// ─────────────────────────────────────────────

model DocumentTemplate {
  id          String   @id @default(cuid())
  schoolId    String?  @map("school_id") // null = global / default
  templateKey String   @map("template_key")
  nameTh      String   @map("name_th")
  description String?  @db.Text
  category    String   // 'memo' | 'tor' | 'comparison' | 'evaluation' | 'po' | 'other'
  htmlContent String   @map("html_content") @db.LongText
  active      Boolean  @default(true)
  version     Int      @default(1)
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  documents ProcurementDocument[]

  @@unique([schoolId, templateKey])
  @@index([schoolId, category])
  @@map("document_templates")
}

model ProcurementDocument {
  id              String   @id @default(cuid())
  schoolId        String   @map("school_id")
  templateId      String   @map("template_id")
  templateKey     String   @map("template_key")
  templateVersion Int      @map("template_version")
  refType         String   @map("ref_type") // 'PurchaseRequest'
  refId           String   @map("ref_id")
  docNo           String?  @map("doc_no")
  title           String
  renderedHtml    String   @map("rendered_html") @db.LongText
  contextData     Json     @map("context_data")
  generatedById   String?  @map("generated_by_id")
  generatedAt     DateTime @default(now()) @map("generated_at")

  template DocumentTemplate @relation(fields: [templateId], references: [id])

  @@index([schoolId, refType, refId])
  @@index([templateKey, generatedAt])
  @@map("procurement_documents")
}

// ─────────────────────────────────────────────
// Phase 4B — Inventory + Asset Register
// ─────────────────────────────────────────────

enum StockMovementType {
  IN
  OUT
  ADJUST
  WRITE_OFF
}

enum AssetStatus {
  ACTIVE
  STORED
  REPAIR
  DISPOSED
}

model InventoryItem {
  id           String   @id @default(cuid())
  schoolId     String   @map("school_id")
  name         String
  unit         String
  category     String?
  currentQty   Decimal  @default(0) @map("current_qty") @db.Decimal(15, 2)
  reorderPoint Decimal? @map("reorder_point") @db.Decimal(15, 2)
  notes        String?  @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  movements StockMovement[]

  @@unique([schoolId, name, unit])
  @@index([schoolId, active])
  @@map("inventory_items")
}

model StockMovement {
  id              String            @id @default(cuid())
  schoolId        String            @map("school_id")
  inventoryItemId String            @map("inventory_item_id")
  type            StockMovementType
  quantity        Decimal           @db.Decimal(15, 2)
  refType         String?           @map("ref_type") // 'ReceivingItem' / 'Issue' / etc
  refId           String?           @map("ref_id")
  unitCost        Decimal?          @map("unit_cost") @db.Decimal(15, 2)
  notes           String?           @db.Text
  createdById     String?           @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, createdAt])
  @@index([refType, refId])
  @@index([schoolId, createdAt])
  @@map("stock_movements")
}

model AssetRegister {
  id                String      @id @default(cuid())
  schoolId          String      @map("school_id")
  assetNumber       String      @map("asset_number")
  name              String
  category          String?
  acquisitionCost   Decimal     @map("acquisition_cost") @db.Decimal(15, 2)
  acquisitionDate   DateTime    @map("acquisition_date")
  serialNumber      String?     @map("serial_number")
  vendorName        String?     @map("vendor_name")
  location          String?
  custodianId       String?     @map("custodian_id")
  status            AssetStatus @default(ACTIVE)
  qrCode            String?     @unique @map("qr_code")
  purchaseRequestId String?     @map("purchase_request_id")
  receivingItemId   String?     @map("receiving_item_id")
  notes             String?     @db.Text
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@unique([schoolId, assetNumber])
  @@index([schoolId, status])
  @@index([category])
  @@index([purchaseRequestId])
  @@map("asset_registers")
}

// ─────────────────────────────────────────────
// Phase 4A — Receiving & Inspection
// ─────────────────────────────────────────────

enum ReceivingStatus {
  IN_PROGRESS
  COMPLETE
  PARTIAL
  REJECTED
  CANCELLED
}

enum ItemReceiveCondition {
  GOOD
  DAMAGED
  WRONG_SPEC
  SHORT_QUANTITY
  NOT_RECEIVED
}

model ReceivingRecord {
  id                String          @id @default(cuid())
  schoolId          String          @map("school_id")
  purchaseRequestId String          @unique @map("purchase_request_id")
  status            ReceivingStatus @default(IN_PROGRESS)
  startedAt         DateTime        @default(now()) @map("started_at")
  finalizedAt       DateTime?       @map("finalized_at")
  finalizedById     String?         @map("finalized_by_id")
  comment           String?         @db.Text
  inspectorIds      Json?           @map("inspector_ids")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  items           ReceivingItem[]

  @@index([schoolId, status])
  @@map("receiving_records")
}

model ReceivingItem {
  id                    String                @id @default(cuid())
  receivingRecordId     String                @map("receiving_record_id")
  purchaseRequestItemId String                @map("purchase_request_item_id")
  quantityReceived      Decimal?              @map("quantity_received") @db.Decimal(12, 2)
  condition             ItemReceiveCondition? @default(GOOD)
  conditionNotes        String?               @map("condition_notes") @db.Text
  inspectedAt           DateTime?             @map("inspected_at")
  inspectedById         String?               @map("inspected_by_id")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  receivingRecord     ReceivingRecord     @relation(fields: [receivingRecordId], references: [id], onDelete: Cascade)
  purchaseRequestItem PurchaseRequestItem @relation(fields: [purchaseRequestItemId], references: [id], onDelete: Cascade)

  @@unique([receivingRecordId, purchaseRequestItemId])
  @@index([purchaseRequestItemId])
  @@map("receiving_items")
}

model Attachment {
  id           String   @id @default(cuid())
  schoolId     String   @map("school_id")
  ownerType    String   @map("owner_type")
  ownerId      String   @map("owner_id")
  filename     String
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  storagePath  String   @map("storage_path")
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, ownerType, ownerId])
  @@map("attachments")
}
