# Database (MariaDB / MySQL via Laragon)
DATABASE_URL="mysql://root:@localhost:3306/ai_market"

# API
API_PORT=3100
API_URL="http://localhost:3100"
# Generate strong values: `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`
JWT_SECRET="REPLACE_WITH_RANDOM_48_BYTES_BASE64"
JWT_REFRESH_SECRET="REPLACE_WITH_RANDOM_48_BYTES_BASE64_DIFFERENT_FROM_ABOVE"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
COOKIE_DOMAIN="localhost"

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3100/api/v1"

# AI (OpenRouter — OpenAI-compatible API gateway)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"
OPENROUTER_FAST_MODEL="google/gemini-2.5-flash"
OPENROUTER_REFERER="http://localhost:3000"
OPENROUTER_APP_TITLE="FinProcure AI"

# Storage
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
